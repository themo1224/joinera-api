APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Joinera mailbox — GMX manual attach (Admin PUT .../mailbox/credentials).
# mode must be set for identity readiness; driver=fake uses in-memory IMAP/SMTP fakes.
JOINERA_MAILBOX_MODE=gmx_manual
JOINERA_MAILBOX_DRIVER=gmx
JOINERA_GMX_ALLOWED_HOSTS=gmx.de,gmx.net
JOINERA_GMX_IMAP_HOST=imap.gmx.net
JOINERA_GMX_IMAP_PORT=993
JOINERA_GMX_IMAP_ENCRYPTION=ssl
JOINERA_GMX_SMTP_HOST=mail.gmx.net
JOINERA_GMX_SMTP_PORT=587
JOINERA_GMX_SMTP_ENCRYPTION=tls
# Legacy (unused for GMX v1 apply-mail path):
# JOINERA_MAILBOX_PROVIDER=
# JOINERA_DOMAIN_REGISTRAR=

# Intake sites (comma-separated). Empty = no board crawl.
JOINERA_SITES_V1=ausbildung.de,azubiyo,arbeitsagentur.de
# JOINERA_AUSBILDUNG_DE_MAX_PAGES=5
# JOINERA_AUSBILDUNG_DE_HTTP=fake
# JOINERA_AUSBILDUNG_DE_SEARCH_URL=https://www.ausbildung.de/suche/
# JOINERA_AUSBILDUNG_DE_BASE_URL=https://www.ausbildung.de
# JOINERA_AZUBIYO_MAX_PAGES=5
# JOINERA_AZUBIYO_HTTP=fake
# JOINERA_AZUBIYO_SEARCH_URL=https://www.azubiyo.de/stellenmarkt/
# JOINERA_AZUBIYO_BASE_URL=https://www.azubiyo.de
# JOINERA_ARBEITSAGENTUR_DE_MAX_PAGES=5
# JOINERA_ARBEITSAGENTUR_DE_HTTP=fake
# JOINERA_ARBEITSAGENTUR_DE_JOBS_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
# JOINERA_ARBEITSAGENTUR_DE_AUSBILDUNG_BASE_URL=https://rest.arbeitsagentur.de/infosysbub/absuche
# JOINERA_ARBEITSAGENTUR_DE_PORTAL_BASE_URL=https://www.arbeitsagentur.de
# Public clientIds for X-API-Key (not Candidate credentials):
# JOINERA_ARBEITSAGENTUR_DE_JOBS_API_KEY=jobboerse-jobsuche
# JOINERA_ARBEITSAGENTUR_DE_AUSBILDUNG_API_KEY=infosysbub-absuche

# Q17 apply volume (Applications per Candidate per window)
JOINERA_APPLY_CAP=10
JOINERA_APPLY_CAP_WINDOW=daily

# AI / LLM port (OpenRouter now; swap driver later for OpenAI without rewriting jobs)
JOINERA_AI_DRIVER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap/free default. Paid example: openai/gpt-4o-mini
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks after primary. Use only :free / openrouter/free to stay free.
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.2-3b-instruct:free,google/gemma-2-9b-it:free
OPENROUTER_APP_TITLE=Joinera
# OPENROUTER_HTTP_REFERER=https://your-domain.example
# OPENROUTER_TIMEOUT=60

