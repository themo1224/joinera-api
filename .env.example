APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed longest job runtime (intake detail crawls can take several minutes).
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Joinera mailbox — GMX manual attach (Admin PUT .../mailbox/credentials).
# mode must be set for identity readiness; driver=fake uses in-memory IMAP/SMTP fakes.
JOINERA_MAILBOX_MODE=gmx_manual
JOINERA_MAILBOX_DRIVER=gmx
JOINERA_GMX_ALLOWED_HOSTS=gmx.de,gmx.net
JOINERA_GMX_IMAP_HOST=imap.gmx.net
JOINERA_GMX_IMAP_PORT=143
JOINERA_GMX_IMAP_ENCRYPTION=starttls
JOINERA_GMX_SMTP_HOST=mail.gmx.net
JOINERA_GMX_SMTP_PORT=587
JOINERA_GMX_SMTP_ENCRYPTION=tls
# Legacy (unused for GMX v1 apply-mail path):
# JOINERA_MAILBOX_PROVIDER=
# JOINERA_DOMAIN_REGISTRAR=

# Intake sites (comma-separated). Empty = no board crawl.
JOINERA_SITES_V1=ausbildung.de,azubiyo,arbeitsagentur.de
# JOINERA_AUSBILDUNG_DE_MAX_PAGES=5
# JOINERA_AUSBILDUNG_DE_HTTP=fake
# JOINERA_AUSBILDUNG_DE_SEARCH_URL=https://www.ausbildung.de/suche/
# JOINERA_AUSBILDUNG_DE_BASE_URL=https://www.ausbildung.de
# JOINERA_AZUBIYO_MAX_PAGES=5
# JOINERA_AZUBIYO_HTTP=fake
# JOINERA_AZUBIYO_SEARCH_URL=https://www.azubiyo.de/stellenmarkt/
# JOINERA_AZUBIYO_BASE_URL=https://www.azubiyo.de
# JOINERA_ARBEITSAGENTUR_DE_MAX_PAGES=5
# JOINERA_ARBEITSAGENTUR_DE_HTTP=fake
# JOINERA_ARBEITSAGENTUR_DE_JOBS_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service
# JOINERA_ARBEITSAGENTUR_DE_AUSBILDUNG_BASE_URL=https://rest.arbeitsagentur.de/infosysbub/absuche
# JOINERA_ARBEITSAGENTUR_DE_PORTAL_BASE_URL=https://www.arbeitsagentur.de
# Public clientIds for X-API-Key (not Candidate credentials):
# JOINERA_ARBEITSAGENTUR_DE_JOBS_API_KEY=jobboerse-jobsuche
# JOINERA_ARBEITSAGENTUR_DE_AUSBILDUNG_API_KEY=infosysbub-absuche

# Q17 apply volume (Applications per Candidate per window)
JOINERA_APPLY_CAP=10
JOINERA_APPLY_CAP_WINDOW=daily
# Plan 32 / P0-14 — leave unset (null) to keep anti-block layers inactive.
# JOINERA_ANTI_BLOCK_JITTER_MIN=2
# JOINERA_ANTI_BLOCK_JITTER_MAX=8
# JOINERA_ANTI_BLOCK_MAX_PER_HOUR=6
# JOINERA_ANTI_BLOCK_COOLDOWN_SECONDS=1800

# Mode B browser submit (see browser-worker/README.md and docs/AZUBIYO_LOVE_PATH_RUNBOOK.md)
# fixture = in-process stub (default, tests/local without worker)
# http = Playwright worker at JOINERA_MODE_B_WORKER_URL
JOINERA_MODE_B_DRIVER=fixture
JOINERA_MODE_B_WORKER_URL=http://127.0.0.1:3911
JOINERA_MODE_B_WORKER_SECRET=dev-shared-secret
# JOINERA_MODE_B_TIMEOUT=120
# Legacy board Easy-Apply claim path (default off — company site only)
# JOINERA_MODE_B_ALLOW_BOARD_APPLY=false
# JOINERA_QUEUE_DOCS=docs
# JOINERA_QUEUE_APPLY=apply

# Document ingestion (staff CV/passport/certs). Matching engine untouched.
# JOINERA_CV_PARSER=ingestion
# JOINERA_DOCUMENT_OCR=tesseract
# Residual OpenRouter fill for gaps after OCR/heuristics (name, DOB, education, experiences, languages).
# Requires OPENROUTER_API_KEY. Config default is false when unset — set true for local/dev / PO-paid usage.
JOINERA_DOCUMENT_RESIDUAL_LLM=true

# AI / LLM port — openrouter (prod) | gemini (local/test PDF/image analyze) | fake
JOINERA_AI_DRIVER=openrouter
# Gemini (optional local/test driver for staff document analyze)
GEMINI_API_KEY=
# Prefer lite on free tier (higher RPM/RPD). Gemini 3 Flash free is ~5 RPM / 20 RPD.
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3-flash-preview,gemini-flash-latest
# GEMINI_TIMEOUT=180
# GEMINI_CONNECT_TIMEOUT=45
# GEMINI_RETRIES=2
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Prefer a fast paid model when PO pays (batch PDF analyze + residual fill). Free fallback: openrouter/free
# OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks after primary. Use only :free / openrouter/free to stay free.
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.2-3b-instruct:free,google/gemma-2-9b-it:free
OPENROUTER_APP_TITLE=Joinera
# OPENROUTER_HTTP_REFERER=https://your-domain.example
# Staff "Fill profile from documents" sends PDFs to OpenRouter (no local Tesseract/Imagick required).
# PDF engine: mistral-ocr | cloudflare-ai | native
OPENROUTER_PDF_ENGINE=mistral-ocr
# Batch analyze + OCR often needs a long timeout; SSL handshake may also be slow on VPN.
OPENROUTER_TIMEOUT=180
OPENROUTER_CONNECT_TIMEOUT=45
OPENROUTER_RETRIES=3

